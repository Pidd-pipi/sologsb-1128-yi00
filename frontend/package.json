{
  "name": "gbfishport-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "test:emergency": "esbuild scripts/emergency.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/emergency.test.mjs --log-level=warning && node node_modules/.cache/emergency.test.mjs",
    "test:seed": "esbuild scripts/seed.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/seed.test.mjs --log-level=warning && node node_modules/.cache/seed.test.mjs",
    "test:migration": "esbuild scripts/migration.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/migration.test.mjs --log-level=warning && node node_modules/.cache/migration.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.8",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
